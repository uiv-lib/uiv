{
  "name": "uiv",
  "version": "2.0.6",
  "description": "Bootstrap 3 components implemented by Vue.",
  "author": "wxsm",
  "type": "module",
  "main": "./dist/uiv.umd.js",
  "module": "./dist/uiv.es.js",
  "exports": {
    ".": {
      "import": "./dist/uiv.es.js",
      "require": "./dist/uiv.umd.js"
    }
  },
  "unpkg": "./dist/uiv.umd.js",
  "jsdelivr": "./dist/uiv.umd.js",
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uiv-lib/uiv.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/uiv-lib/uiv/issues"
  },
  "homepage": "https://uiv.wxsm.space",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "start": "npm run dev",
    "dev": "npm run docs:dev",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "dist": "vite build -c build/vite.config.js && node build/single.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint --ext .js,.vue src build docs/.vitepress",
    "lint:fix": "npm run lint -- --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/compiler-sfc": "3.5.40",
    "@vue/test-utils": "2.4.11",
    "@vitest/coverage-v8": "4.1.10",
    "axios": "1.19.0",
    "bootstrap": "3.4.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-html": "8.1.4",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-vue": "10.10.0",
    "globals": "^17.7.0",
    "jsdom": "29.1.1",
    "less": "4.8.1",
    "lodash": "4.18.1",
    "prettier": "3.9.6",
    "vite": "8.1.5",
    "vitepress": "1.6.4",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-eslint-parser": "^10.4.1",
    "vue-i18n": "11.4.8"
  },
  "peerDependencies": {
    "vue": "^3"
  },
  "engines": {
    "node": ">= 4.0.0",
    "npm": ">= 3.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 8"
  ],
  "keywords": [
    "Bootstrap",
    "Bootstrap 3",
    "Bootstrap for Vue",
    "SSR",
    "Web",
    "Components",
    "Directives",
    "Vue",
    "VueJS",
    "Vue3",
    "WebComponents",
    "vue-strap",
    "vuestrap",
    "CSS",
    "Affix",
    "MessageBox",
    "Notification",
    "ScrollSpy",
    "Alert",
    "Button",
    "Button group",
    "Breadcrumbs",
    "Carousel",
    "Slider",
    "Collapse",
    "Dropdown",
    "Nav",
    "Modal",
    "Navbar",
    "Pagination",
    "Popover",
    "Progress",
    "Tab",
    "Tooltip",
    "Typeahead",
    "Auto complete",
    "Multi select"
  ]
}
